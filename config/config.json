{


    "mongo" : {
        "host" : "localhost",
        "port" : "27017",
        "database" : "cloudMusicDevelopment"
    },

    "express": {
        "view cache": false,
        "view engine": "js",
        "views": "path:./.build/templates"
    },



    "view engines": {
        "js": {
            "module": "engine-munger",
            "renderer": {
                "method": "js",
                "arguments": [
                    { "cache": true },
                    {
                        "views": "config:express.views",
                        "view engine": "config:express.view engine",
                        "specialization": "config:specialization",
                        "i18n": "config:i18n"
                    }
                ]
            }
        }
    },


    "bcrypt": {
        "difficulty": 8
    },

    "i18n": {
        "contentPath": "path:./locales",
        "fallback": "en-US"
    },


    "specialization": {
    },

    "middleware": {


        "appsec": {
            "priority": 110,
            "module": {
                "name": "lusca",
                "arguments": [
                    {
                        "csrf": false,
                        "xframe": false,
                        "p3p": false,
                        "csp": false
                    }
                ]
            }
        },

        "expressView": {
            "priority": 100,
            "enabled": true,
            "module": {
                "name": "engine-munger/lib/expressView"
            }
        },


        "static": {
            "module": {
                "arguments": [ "path:./.build" ]
            }
        },

        "router": {
            "module": {
                "arguments": [{ "directory": "path:./controllers" }]
            }
        },

        "flash": {
            "priority": 91,
            "enabled": true,
            "module": {
                "name": "connect-flash",
                "method": "flash"
            }
        },
        "json": {
            "enabled": true,
            "priority": 10,
            "module": {
                "name": "body-parser",
                "method": "json",
                "arguments": [
                    {
                        "limit": 52428800
                    }
                ]
            }
        },
        "raw": {
            "enabled": true,
            "priority": 10,
            "module": {
                "name": "body-parser",
                "method": "raw",
                "arguments": [
                    {
                        "limit": 52428800
                    }
                ]
            }
        },
        "text": {
            "enabled": true,
            "priority": 10,
            "module": {
                "name": "body-parser",
                "method": "text",
                "arguments": [
                    {
                        "limit": 52428800
                    }
                ]
            }
        },
        "multipart": {
            "enabled": false,
            "priority": 150,
            "module": {
                "name": "kraken-js/middleware/multipart"
            }
        },
        "multer": {
            "priority": 110,
            "enabled": true,
            "module": {
                "name": "multer",
                "arguments": [
                    {
                        "dest": "path:./public/uploads/media"
                    }
                ]
            }
        }

    }
}
